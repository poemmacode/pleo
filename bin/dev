#!/usr/bin/env bash
# Starts Postgres (project-local), the Rails app and Sidekiq. Ctrl-C stops all of them.
# Redis is expected on 127.0.0.1:6379 (brew services or docker compose up redis).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$HOME/.asdf/shims:$PATH"

"$ROOT/bin/db" start

if ! (exec 3<>/dev/tcp/127.0.0.1/6379) 2>/dev/null; then
  echo "Redis is not answering on 127.0.0.1:6379. Start it with 'brew services start redis' or 'docker compose up -d redis'." >&2
  exit 1
fi

(cd "$ROOT" && bin/rails db:prepare >/dev/null)

pids=()
cleanup() {
  trap - INT TERM EXIT
  kill "${pids[@]}" 2>/dev/null || true
  wait 2>/dev/null || true
}
trap cleanup INT TERM EXIT

(cd "$ROOT" && exec bin/rails server -b 127.0.0.1 -p 3000) & pids+=($!)
(cd "$ROOT" && exec bundle exec sidekiq -C config/sidekiq.yml) & pids+=($!)

echo "http://127.0.0.1:3000"

# macOS ships bash 3.2 (no `wait -n`): stop everything as soon as any process exits.
while true; do
  for pid in "${pids[@]}"; do
    kill -0 "$pid" 2>/dev/null || exit 1
  done
  sleep 1
done
