#!/usr/bin/env bash
# Starts Postgres (project-local), the Rails API, Sidekiq and the Vite dev server. Ctrl-C stops all of them.
# Redis is expected on 127.0.0.1:6379 (brew services or docker compose up redis).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$HOME/.asdf/shims:$HOME/.asdf/installs/nodejs/22.19.0/bin:$PATH"

"$ROOT/bin/db" start

if ! (exec 3<>/dev/tcp/127.0.0.1/6379) 2>/dev/null; then
  echo "Redis no responde en 127.0.0.1:6379. Arráncalo con 'brew services start redis' o 'docker compose up -d redis'." >&2
  exit 1
fi

(cd "$ROOT/api" && bin/rails db:prepare >/dev/null)

pids=()
cleanup() {
  trap - INT TERM EXIT
  kill "${pids[@]}" 2>/dev/null || true
  wait 2>/dev/null || true
}
trap cleanup INT TERM EXIT

(cd "$ROOT/api" && exec bin/rails server -b 127.0.0.1 -p 3000) & pids+=($!)
(cd "$ROOT/api" && exec bundle exec sidekiq -C config/sidekiq.yml) & pids+=($!)
(cd "$ROOT/web" && exec npm run dev -- --host 127.0.0.1) & pids+=($!)

echo "API http://127.0.0.1:3000 · Web http://127.0.0.1:5173"

# macOS ships bash 3.2 (no `wait -n`): stop everything as soon as any process exits.
while true; do
  for pid in "${pids[@]}"; do
    kill -0 "$pid" 2>/dev/null || exit 1
  done
  sleep 1
done
