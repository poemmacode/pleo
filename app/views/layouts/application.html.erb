<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "SEO Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% if authenticated? %>
      <header class="topbar">
        <%= link_to "SEO Platform", root_path, class: "brand" %>
        <span class="row">
          <span class="muted"><%= Current.user.email %></span>
          <%= button_to "Salir", session_path, method: :delete, class: "secondary" %>
        </span>
      </header>
    <% end %>
    <div class="flash-area"><%= render "shared/flash" %></div>
    <%= yield %>
  </body>
</html>
