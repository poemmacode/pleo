<% content_for :title, t(".page_title") %>
<main class="narrow">
  <h1><%= t("app.name") %></h1>
  <%= form_with url: session_path, class: "card stack" do |f| %>
    <%= f.label :email do %>
      <%= t(".email") %>
      <%= f.email_field :email, value: params[:email], required: true, autocomplete: "username", autofocus: true %>
    <% end %>
    <%= f.label :password do %>
      <%= t(".password") %>
      <%= f.password_field :password, required: true, autocomplete: "current-password" %>
    <% end %>
    <div><%= f.submit t(".submit"), data: { turbo_submits_with: t(".submitting") } %></div>
  <% end %>
  <% if RegistrationsController.open? %>
    <p class="muted"><%= t(".no_account") %> <%= link_to t(".sign_up"), new_registration_path %></p>
  <% end %>
</main>
