<% content_for :title, t(".page_title") %>
<% content_for :description, t(".meta_description") %>
<main class="landing">
  <section class="hero">
    <p class="eyebrow"><%= t(".hero.eyebrow") %></p>
    <h1><%= t(".hero.title") %></h1>
    <p class="lead"><%= t(".hero.lead") %></p>
    <div class="row cta">
      <% if RegistrationsController.open? %>
        <%= link_to t(".cta.sign_up"), new_registration_path, class: "button" %>
      <% end %>
      <%= link_to t(".cta.sign_in"), new_session_path, class: "button secondary" %>
    </div>
    <p class="muted"><%= t(".hero.note") %></p>
  </section>

  <dl class="highlights">
    <% %w[checks pages reports api].each do |key| %>
      <div><dt><%= t(".highlights.#{key}.value") %></dt><dd><%= t(".highlights.#{key}.label") %></dd></div>
    <% end %>
  </dl>

  <section id="features">
    <h2><%= t(".features.title") %></h2>
    <p class="muted"><%= t(".features.lead") %></p>
    <div class="feature-grid">
      <% %w[crawler audit health performance duplicates structured_data reports live api verification].each do |key| %>
        <article class="card">
          <h3><%= t(".features.items.#{key}.title") %></h3>
          <p><%= t(".features.items.#{key}.body") %></p>
        </article>
      <% end %>
    </div>
  </section>

  <section>
    <h2><%= t(".steps.title") %></h2>
    <ol class="steps">
      <% %w[add crawl fix].each do |key| %>
        <li class="card">
          <h3><%= t(".steps.#{key}.title") %></h3>
          <p><%= t(".steps.#{key}.body") %></p>
        </li>
      <% end %>
    </ol>
  </section>

  <section>
    <h2><%= t(".audiences.title") %></h2>
    <div class="feature-grid">
      <% %w[agencies teams developers].each do |key| %>
        <article class="card">
          <h3><%= t(".audiences.#{key}.title") %></h3>
          <p><%= t(".audiences.#{key}.body") %></p>
        </article>
      <% end %>
    </div>
  </section>

  <section>
    <h2><%= t(".trust.title") %></h2>
    <ul class="checklist">
      <% %w[robots rate verification security uptime].each do |key| %>
        <li><%= t(".trust.items.#{key}") %></li>
      <% end %>
    </ul>
    <p><%= link_to t(".trust.status_link"), status_path %> · <%= link_to t(".trust.api_link"), api_docs_path %></p>
  </section>

  <section class="card final-cta">
    <h2><%= t(".final.title") %></h2>
    <p><%= t(".final.body") %></p>
    <div class="row cta">
      <% if RegistrationsController.open? %>
        <%= link_to t(".cta.sign_up"), new_registration_path, class: "button" %>
      <% end %>
      <%= link_to t(".cta.sign_in"), new_session_path, class: "button secondary" %>
    </div>
  </section>
</main>
