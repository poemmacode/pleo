<% content_for :title, "SEOPlatformBot" %>
<% limits = Crawling::CrawlConfig::LIMITS[:unverified] %>
<main class="narrow">
  <h1>SEOPlatformBot</h1>
  <p><%= t(".intro") %></p>
  <h2><%= t(".behaviour") %></h2>
  <ul>
    <li><%= t(".robots_html") %></li>
    <li><%= t(".unverified_limits", pages: number_with_delimiter(limits[:max_pages]), rps: format_score(limits[:max_rps])) %></li>
    <li><%= t(".backoff_html") %></li>
    <li><%= t(".no_js") %></li>
  </ul>
  <h2><%= t(".block") %></h2>
  <p><%= t(".block_how_html") %></p>
  <pre><code>User-agent: SEOPlatformBot
Disallow: /</code></pre>
</main>
