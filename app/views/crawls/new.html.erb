<% content_for :title, t(".page_title") %>
<% defaults = Crawling::CrawlConfig.defaults_for(@domain) %>
<% err = ->(field) { message = @errors&.find { _1[:field] == field.to_s }&.dig(:detail); tag.span(message, class: "error", role: "alert") if message } %>
<main>
  <p><%= link_to "← #{@project.name}", @project %></p>
  <h1><%= t(".heading") %></h1>
  <% general = @errors&.select { _1[:field].nil? } %>
  <% general&.each do |error| %>
    <p class="flash flash-alert" role="alert"><%= error[:detail] %></p>
  <% end %>

  <%= form_with scope: :crawl, url: project_crawls_path(@project), class: "card stack" do |f| %>
    <label>
      <%= t(".domain") %>
      <%= f.select :domain_id, @project.domains.sort_by(&:host).map { [ _1.verified? ? _1.host : t(".unverified_option", host: _1.host), _1.id ] },
                   { selected: @domain.id },
                   data: { controller: "domain-switch", action: "domain-switch#visit",
                           domain_switch_url_value: new_project_crawl_path(@project) } %>
    </label>
    <% unless @domain.verified? %>
      <% limits = Crawling::CrawlConfig::LIMITS[:unverified] %>
      <p class="notice"><%= t(".unverified_notice", pages: number_with_delimiter(limits[:max_pages]), rps: format_score(limits[:max_rps])) %></p>
    <% end %>

    <label>
      <%= t(".start_url") %>
      <%= f.text_field :start_url, value: @form[:start_url], placeholder: "https://#{@domain.host}/" %>
      <span class="muted"><%= t(".start_url_hint", url: "https://#{@domain.host}/") %></span>
      <%= err.call(:start_url) %>
    </label>

    <div class="grid">
      <label>
        <%= t(".scope") %>
        <%= f.select :scope, %w[domain subdomain subfolder].map { [ t(".scopes.#{_1}"), _1 ] }, selected: @form[:scope] %>
        <%= err.call(:scope) %>
      </label>
      <label>
        <%= t(".device") %>
        <%= f.select :device, %w[desktop mobile].map { [ t(".devices.#{_1}"), _1 ] }, selected: @form[:device] %>
      </label>
      <label>
        <%= t(".max_pages") %>
        <%= f.number_field :max_pages, value: @form[:max_pages], min: 1, placeholder: defaults[:max_pages].to_s %>
        <%= err.call(:max_pages) %>
      </label>
      <label>
        <%= t(".requests_per_second") %>
        <%= f.number_field :requests_per_second, value: @form[:requests_per_second], step: 0.1, min: 0.2,
                           placeholder: defaults[:requests_per_second].to_s %>
        <%= err.call(:requests_per_second) %>
      </label>
      <label>
        <%= t(".max_depth") %>
        <%= f.number_field :max_depth, value: @form[:max_depth], min: 0, placeholder: "10" %>
        <%= err.call(:max_depth) %>
      </label>
    </div>

    <label>
      <%= t(".exclude_patterns") %>
      <%= f.text_area :exclude_patterns, value: Array(@form[:exclude_patterns]).join("\n"), rows: 3 %>
      <span class="muted"><%= t(".patterns_hint") %></span>
      <%= err.call(:exclude_patterns) %>
    </label>
    <label>
      <%= t(".include_patterns") %>
      <%= f.text_area :include_patterns, value: Array(@form[:include_patterns]).join("\n"), rows: 2 %>
      <%= err.call(:include_patterns) %>
    </label>

    <label class="check"><%= f.check_box :use_sitemaps, checked: @form[:use_sitemaps].to_s != "0" && @form[:use_sitemaps] != false %> <%= t(".use_sitemaps") %></label>
    <label class="check"><%= f.check_box :respect_nofollow, checked: @form[:respect_nofollow].to_s == "1" %> <%= t(".respect_nofollow") %></label>
    <div class="row">
      <label class="check"><%= f.check_box :run_pagespeed, checked: @form[:run_pagespeed].to_s != "0" && @form[:run_pagespeed] != false %> <%= t(".run_pagespeed") %></label>
      <label class="inline">
        <%= t(".pagespeed_sample") %>
        <%= f.number_field :pagespeed_sample, value: @form[:pagespeed_sample], min: 1, max: Crawling::CrawlConfig::MAX_PAGESPEED_SAMPLE, placeholder: "10", class: "narrow-input" %>
      </label>
    </div>
    <%= err.call(:pagespeed_sample) %>
    <% unless Performance.api_key %>
      <p class="muted"><%= t(".pagespeed_key_missing_html") %></p>
    <% end %>
    <% unless @domain.verified? %>
      <label class="check">
        <%= f.check_box :terms_accepted, checked: @form[:terms_accepted].to_s == "1" %>
        <%= t(".terms", host: @domain.host) %>
      </label>
      <%= err.call(:terms_accepted) %>
    <% end %>

    <p class="muted"><%= t(".robots_note") %></p>
    <div><%= f.submit t(".submit"), data: { turbo_submits_with: t(".submitting") } %></div>
  <% end %>
</main>
