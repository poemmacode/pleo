<%= turbo_frame_tag "issue_#{@definition.key.parameterize}" do %>
  <ul class="plain" id="<%= "findings_#{@definition.key.parameterize}" %>">
    <%= render partial: "crawls/issues/finding", collection: @findings, locals: { crawl: @crawl } %>
  </ul>
  <%= render "crawls/issues/more", crawl: @crawl, definition: @definition, next_cursor: @next_cursor %>
<% end %>
