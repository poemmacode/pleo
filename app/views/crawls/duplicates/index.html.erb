<% content_for :title, "Duplicados · SEO Platform" %>
<main>
  <p><%= link_to "← Crawl", @crawl %></p>
  <h1>Duplicados en <%= @crawl.domain.host %></h1>
  <nav class="row tabs">
    <% Audit::Duplicates::TYPES.each do |type, label| %>
      <%= link_to label, crawl_duplicates_path(@crawl, type:), class: ("active" if type == @type), "aria-current": ("page" if type == @type) %>
    <% end %>
  </nav>
  <% if @groups.empty? %><p class="muted">No hay duplicados de este tipo entre las páginas indexables.</p><% end %>
  <ul class="list">
    <% @groups.each do |pages| %>
      <li class="card stack">
        <strong><%= Audit::Duplicates.label(@type, pages) %></strong>
        <span class="muted"><%= pages.size %> páginas</span>
        <ul class="plain">
          <% pages.each do |page| %><li><%= link_to page.url, crawl_page_path(@crawl, page) %></li><% end %>
        </ul>
      </li>
    <% end %>
  </ul>
</main>
