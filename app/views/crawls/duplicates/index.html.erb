<% content_for :title, t(".page_title") %>
<main>
  <p><%= link_to t(".back"), @crawl %></p>
  <h1><%= t(".heading", host: @crawl.domain.host) %></h1>
  <nav class="row tabs">
    <% Audit::Duplicates::TYPES.each do |type| %>
      <%= link_to t(".types.#{type}"), crawl_duplicates_path(@crawl, type:), class: ("active" if type == @type), "aria-current": ("page" if type == @type) %>
    <% end %>
  </nav>
  <% if @groups.empty? %><p class="muted"><%= t(".empty") %></p><% end %>
  <ul class="list">
    <% @groups.each do |pages| %>
      <li class="card stack">
        <strong><%= Audit::Duplicates.label(@type, pages) %></strong>
        <span class="muted"><%= t(".pages", count: pages.size) %></span>
        <ul class="plain">
          <% pages.each do |page| %><li><%= link_to page.url, crawl_page_path(@crawl, page) %></li><% end %>
        </ul>
      </li>
    <% end %>
  </ul>
</main>
