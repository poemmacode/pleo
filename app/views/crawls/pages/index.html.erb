<%= turbo_frame_tag "pages" do %>
  <section class="card stack">
    <div class="row">
      <h2><%= t(".heading") %></h2>
      <%= form_with url: crawl_pages_path(@crawl), method: :get, class: "inline", data: { controller: "autosubmit" } do %>
        <label class="inline">
          <%= t(".status") %>
          <%= select_tag :status, options_for_select(page_status_filter_options, @status), data: { action: "autosubmit#submit" } %>
        </label>
        <noscript><%= submit_tag t(".filter") %></noscript>
      <% end %>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>URL</th><th><%= t(".status") %></th><th><%= t(".depth") %></th><th>Sitemap</th><th>ms</th></tr></thead>
        <tbody id="page_rows">
          <%= render partial: "crawls/pages/row", collection: @pages, as: :page, locals: { crawl: @crawl } %>
        </tbody>
      </table>
    </div>
    <% if @pages.empty? %><p class="muted"><%= t(".empty") %></p><% end %>
    <%= render "crawls/pages/more", crawl: @crawl, next_cursor: @next_cursor, status: @status %>
  </section>
<% end %>
