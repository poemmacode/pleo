<% content_for :title, "#{@page.url} · SEO Platform" %>
<main>
  <p><%= link_to "← Crawl", @crawl %></p>
  <h1 class="url"><%= @page.url %></h1>
  <section class="card">
    <dl class="dns">
      <dt>Estado</dt><dd><%= @page.status_code || @page.fetch_error %></dd>
      <dt>Indexable</dt><dd><%= @page.indexable ? "sí" : "no (#{@page.indexability_reason})" %></dd>
      <dt>Title</dt><dd><%= @page.title || "—" %></dd>
      <dt>Description</dt><dd><%= @page.meta_description || "—" %></dd>
      <dt>Canonical</dt><dd><%= @page.canonical || @page.canonical_hrefs.join(", ").presence || "—" %></dd>
      <dt>Robots</dt><dd><%= [ @page.meta_robots, @page.x_robots_tag ].compact_blank.join(" · ").presence || "—" %></dd>
      <dt>Idioma</dt><dd><%= @page.lang || "—" %></dd>
      <dt>Palabras</dt><dd><%= @page.word_count || "—" %></dd>
      <dt>Profundidad</dt><dd><%= @page.depth || "—" %></dd>
      <dt>Enlaces entrantes</dt><dd><%= @page.inlinks_count %></dd>
      <dt>Imágenes sin alt</dt><dd><%= @page.images_missing_alt.to_i %> de <%= @page.images_count.to_i %></dd>
    </dl>
  </section>

  <section class="card stack">
    <h2>Problemas</h2>
    <% if @issues.empty? %>
      <p class="muted">Ninguno.</p>
    <% else %>
      <ul class="plain">
        <% @issues.each do |key, severity, title, details| %>
          <li><%= severity_badge(severity) %> <%= title %><% if details.present? %><span class="muted"> — <%= format_details(details) %></span><% end %></li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <div class="grid">
    <section class="card">
      <h2>Encabezados</h2>
      <ul class="plain headings">
        <% @page.headings.each do |heading| %>
          <li style="padding-left: <%= (heading["level"].to_i - 1) * 12 %>px"><code>H<%= heading["level"] %></code> <%= heading["text"] %></li>
        <% end %>
      </ul>
    </section>
    <section class="card">
      <h2>Datos estructurados</h2>
      <% if @page.structured_data.empty? %><p class="muted">Sin marcado.</p><% end %>
      <ul class="plain">
        <% @page.structured_data.each do |item| %>
          <li>
            <code><%= item.syntax %></code> <%= item.types.join(", ").presence || "(sin tipo)" %>
            <% unless item.valid_syntax %><span class="error">sintaxis inválida</span><% end %>
            <% item.validation_errors.each do |error| %><div class="error"><%= error.is_a?(Hash) ? error.values.join(" · ") : error %></div><% end %>
            <% item.validation_warnings.first(5).each do |warning| %><div class="muted"><%= warning.values.join(" · ") %></div><% end %>
          </li>
        <% end %>
      </ul>
    </section>
  </div>

  <section class="card stack">
    <h2>Enlaces salientes (<%= @outlinks.size %>)</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>URL</th><th>Anchor</th><th>Tipo</th></tr></thead>
        <tbody>
          <% @outlinks.each do |link| %>
            <tr><td class="url"><%= link.to_url %></td><td><%= link.anchor %></td><td><%= link.internal ? "interno" : "externo" %><%= " (#{link.rel.join(" ")})" if link.rel.any? %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <h2>Enlaces entrantes (<%= @inlinks.size %>)</h2>
    <ul class="plain">
      <% @inlinks.each do |url, anchor| %><li><code><%= url %></code><%= " — #{anchor}" if anchor.present? %></li><% end %>
    </ul>
  </section>
</main>
