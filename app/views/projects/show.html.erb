<% content_for :title, "#{@project.name} · SEO Platform" %>
<main>
  <p><%= link_to "← Proyectos", root_path %></p>
  <h1><%= @project.name %></h1>

  <h2>Dominios</h2>
  <%= form_with model: [ @project, @domain ], class: "inline-form" do |f| %>
    <%= f.label :host do %>
      Añadir dominio
      <%= f.text_field :host, value: @domain.host_input, placeholder: "ejemplo.com", "aria-invalid": @domain.errors[:host].any? %>
    <% end %>
    <%= f.submit "Añadir" %>
  <% end %>
  <%= field_error(@domain, :host) %>

  <ul class="list">
    <%= render partial: "domains/domain", collection: @project.domains.select(&:persisted?).sort_by(&:host) %>
  </ul>

  <% if @project.domains.any? %>
    <h2>Crawls</h2>
    <% crawls = @project.crawls.includes(:domain).order(created_at: :desc).limit(20) %>
    <% if crawls.empty? %>
      <p class="muted">Todavía no hay crawls.</p>
    <% end %>
    <ul class="list">
      <% crawls.each do |crawl| %>
        <li class="card">
          <%= link_to "#{crawl.domain.host} · #{l(crawl.created_at, format: :short)}", crawl %>
          <span class="muted"><%= crawl_status_label(crawl.status) %> · <%= pluralize(crawl.pages_crawled, "página") %></span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <p><%= button_to "Eliminar proyecto", @project, method: :delete, class: "danger",
                   form: { data: { turbo_confirm: "¿Eliminar este proyecto, sus dominios y sus crawls?" } } %></p>
</main>
