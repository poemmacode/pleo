<% content_for :title, t(".page_title") %>
<main>
  <h1><%= t(".heading") %></h1>
  <%= form_with model: @project, class: "inline-form" do |f| %>
    <%= f.label :name do %>
      <%= t(".new_project") %>
      <%= f.text_field :name, placeholder: t(".name_placeholder"), "aria-invalid": @project.errors[:name].any? %>
    <% end %>
    <%= f.submit t(".create") %>
  <% end %>
  <%= field_error(@project, :name) %>

  <% if @projects.empty? %>
    <p class="muted"><%= t(".empty") %></p>
  <% end %>
  <ul class="list">
    <% @projects.each do |project| %>
      <li class="card">
        <%= link_to project.name, project %>
        <span class="muted">
          <%= t(".domains", count: project.domains.size) %> · <%= t(".verified", count: project.domains.count(&:verified?)) %>
          <% if Current.user.admin? && project.user_id != Current.user.id %> · <%= t(".owner", email: project.user.email) %><% end %>
        </span>
      </li>
    <% end %>
  </ul>
</main>
