<li class="card stack" id="<%= dom_id(domain) %>">
  <div class="row">
    <strong><%= domain.host %></strong>
    <span class="badge <%= "ok" if domain.verified? %>"><%= domain.verified? ? t(".verified") : t(".unverified") %></span>
    <%= link_to t(".new_crawl"), new_project_crawl_path(domain.project, domain_id: domain.id) %>
  </div>

  <% unless domain.verified? %>
    <%= form_with url: verify_domain_path(domain), class: "stack", data: { controller: "verification-method" } do |f| %>
      <fieldset class="row methods">
        <legend><%= t(".method") %></legend>
        <% %w[dns_txt html_file meta].each do |method| %>
          <label class="radio">
            <%= radio_button_tag :method, method, method == "dns_txt", id: "#{dom_id(domain)}_#{method}",
                                 data: { action: "verification-method#show" } %>
            <%= t(".methods.#{method}") %>
          </label>
        <% end %>
      </fieldset>

      <div data-verification-method-target="panel" data-method="dns_txt">
        <p><%= t(".dns_instructions") %></p>
        <dl class="dns">
          <dt><%= t(".type") %></dt><dd>TXT</dd>
          <dt><%= t(".name") %></dt><dd><code><%= domain.host %></code></dd>
          <dt><%= t(".value") %></dt><dd><code><%= domain.txt_record_value %></code></dd>
        </dl>
      </div>
      <div data-verification-method-target="panel" data-method="html_file" hidden>
        <p><%= t(".file_instructions") %></p>
        <dl class="dns">
          <dt>URL</dt><dd><code>https://<%= domain.host %><%= Domain::Verifier.file_path(domain) %></code></dd>
          <dt><%= t(".content") %></dt><dd><code><%= domain.txt_record_value %></code></dd>
        </dl>
      </div>
      <div data-verification-method-target="panel" data-method="meta" hidden>
        <p><%= t(".meta_instructions_html", host: domain.host) %></p>
        <p><code><%= Domain::Verifier.meta_tag(domain) %></code></p>
      </div>

      <div class="row">
        <%= f.submit t(".verify"), data: { turbo_submits_with: t(".verifying") } %>
      </div>
    <% end %>
    <div><%= button_to t(".remove"), domain, method: :delete, class: "secondary",
                       form: { data: { turbo_confirm: t(".remove_confirm", host: domain.host) } } %></div>
  <% end %>
</li>
